+
+    def _loop_llm_slow(self) -> None:
+        """鏈湴 LLM 澶у惊鐜細鎱㈤€熻鐭ユ洿鏂般€?+
+        鏍规嵁婵€绱犺绠楅棿闅旓紝鍒版湡鏃讹細
+        1. 璋冪敤 LLM 鏇存柊 world/myself
+        2. 鑾峰彇 active_tnn 闆嗗悎
+        3. 鍚屾鍒?TNNGraph
+        """
+        if not self.state.cold_started or self.llm is None:
